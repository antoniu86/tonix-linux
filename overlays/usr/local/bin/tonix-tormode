#!/bin/bash
# ============================================================================
# Tonix — Tor Firewall Mode Toggle
# ============================================================================
# Usage:
#   tonix-tormode on      Force ALL traffic through Tor
#   tonix-tormode off     Normal networking (direct connections)
#   tonix-tormode status  Show current mode
#
# When "on":
#   - All outbound TCP is transparently proxied through Tor
#   - All DNS is redirected to Tor's DNS resolver
#   - All UDP (except DNS redirect and DHCP) is blocked
#   - IPv6 is fully blocked (can't bypass via IPv6)
#   - Direct connections are rejected — nothing leaks

set -euo pipefail

# FIX 1: Ensure /usr/sbin and /sbin are in PATH (Debian 12 omits them in
#         non-login shells, causing iptables/ip6tables to appear missing)
export PATH="/usr/sbin:/sbin:$PATH"

TOR_USER="debian-tor"
TOR_TRANS_PORT=9040       # Tor transparent proxy port
TOR_DNS_PORT=5300         # Tor DNS port — NOT 5353 (that's mDNS/Avahi, causes conflicts)
TOR_SOCKS_PORT=9050       # Tor SOCKS port (for apps that support it)
TOR_DROPIN="/etc/tor/torrc.d/tonix-transparent.conf"
STATE_FILE="/run/tonix-tormode"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

[[ $EUID -eq 0 ]] || { echo -e "${RED}Must be run as root${NC}"; exit 1; }

# Preflight check — fail clearly if required tools are missing
for cmd in iptables ip6tables curl systemctl ss; do
    command -v "$cmd" &>/dev/null || { echo -e "${RED}Missing required command: $cmd${NC}"; exit 1; }
done

# ============================================================================
# Configure Tor for transparent proxying via drop-in (never touches main torrc)
# ============================================================================
configure_tor() {
    mkdir -p /etc/tor/torrc.d

    cat > "$TOR_DROPIN" << EOF
# Tonix transparent proxy configuration
# Managed by tonix-tormode — do not edit manually

VirtualAddrNetworkIPv4 10.192.0.0/10
AutomapHostsOnResolve 1
TransPort 127.0.0.1:${TOR_TRANS_PORT}
DNSPort 127.0.0.1:${TOR_DNS_PORT}
SocksPort ${TOR_SOCKS_PORT}
EOF

    # Ensure torrc includes the drop-in directory (idempotent)
    if ! grep -q "^%include /etc/tor/torrc.d" /etc/tor/torrc; then
        echo "" >> /etc/tor/torrc
        echo "# Tonix drop-in configs" >> /etc/tor/torrc
        echo "%include /etc/tor/torrc.d/*.conf" >> /etc/tor/torrc
    fi
}

# ============================================================================
# FIX 2: Disable AppArmor confinement for Tor
# The default system_tor AppArmor profile blocks Tor from binding to custom
# ports (TransPort 9040, DNSPort 5300), causing Tor to run but not listen.
# ============================================================================
disable_apparmor_for_tor() {
    if command -v aa-status &>/dev/null && aa-status --enabled 2>/dev/null; then
        echo -e "${CYAN}Disabling AppArmor confinement for Tor...${NC}"

        # Try complain mode first (softer — logs but doesn't block)
        if aa-complain system_tor 2>/dev/null; then
            echo -e "${GREEN}AppArmor set to complain mode for Tor.${NC}"
        # Fall back to full disable via profile unload
        elif apparmor_parser -R /etc/apparmor.d/system_tor 2>/dev/null; then
            echo -e "${GREEN}AppArmor profile unloaded for Tor.${NC}"
        else
            echo -e "${YELLOW}Warning: Could not modify AppArmor for Tor — ports may not bind.${NC}"
        fi
    fi
}

restore_apparmor_for_tor() {
    if command -v aa-status &>/dev/null && aa-status --enabled 2>/dev/null; then
        # Re-enforce the profile on tor_off
        apparmor_parser -r /etc/apparmor.d/system_tor 2>/dev/null || true
        echo -e "${GREEN}AppArmor profile restored for Tor.${NC}"
    fi
}

# ============================================================================
# Wait for Tor to bootstrap (up to 120s)
# Returns 0 on success, 1 on timeout
# ============================================================================
wait_for_tor() {
    echo -e "${CYAN}Waiting for Tor to bootstrap...${NC}"
    local i=0
    while (( i < 120 )); do
        # Check both journalctl and Tor's control port for bootstrap status
        if journalctl -u tor -n 50 --no-pager 2>/dev/null | grep -q "Bootstrapped 100%"; then
            echo -e "${GREEN}Tor is ready.${NC}"
            return 0
        fi
        # Also check if tor process is running at all — fail fast if it died
        if ! systemctl is-active --quiet tor; then
            echo ""
            echo -e "${RED}Tor service stopped unexpectedly. Check: journalctl -u tor -n 30${NC}"
            return 1
        fi
        sleep 2
        (( i += 2 ))
        echo -n "."
    done
    echo ""
    echo -e "${RED}Tor bootstrap timed out after 120s.${NC}"
    echo -e "${YELLOW}Check Tor logs: journalctl -u tor -n 50${NC}"
    return 1
}

# ============================================================================
# Apply iptables rules — lock everything down through Tor
# ============================================================================
apply_iptables() {
    # Stop UFW first so it doesn't re-insert rules over ours
    systemctl stop ufw 2>/dev/null || true
    ufw disable 2>/dev/null || true

    # Flush everything cleanly
    iptables  -F
    iptables  -t nat -F
    iptables  -t mangle -F
    iptables  -X 2>/dev/null || true
    ip6tables -F
    ip6tables -t nat -F 2>/dev/null || true
    ip6tables -X 2>/dev/null || true

    # Block ALL IPv6 — prevents IPv6 leaks bypassing Tor entirely
    ip6tables -P INPUT   DROP
    ip6tables -P FORWARD DROP
    ip6tables -P OUTPUT  DROP

    # ── NAT table: redirect traffic into Tor ──

    # Tor's own traffic must not be redirected (loop prevention)
    iptables -t nat -A OUTPUT -m owner --uid-owner "$TOR_USER" -j RETURN

    # Never redirect loopback
    iptables -t nat -A OUTPUT -o lo -j RETURN
    iptables -t nat -A OUTPUT -d 127.0.0.0/8 -j RETURN

    # Redirect DNS (UDP + TCP port 53) to Tor's DNS listener
    iptables -t nat -A OUTPUT -p udp --dport 53 -j REDIRECT --to-ports "$TOR_DNS_PORT"
    iptables -t nat -A OUTPUT -p tcp --dport 53 -j REDIRECT --to-ports "$TOR_DNS_PORT"

    # Redirect all outbound TCP to Tor's transparent proxy
    iptables -t nat -A OUTPUT -p tcp --syn -j REDIRECT --to-ports "$TOR_TRANS_PORT"

    # ── Filter table: enforce no bypass ──

    # Default policies — drop everything not explicitly allowed
    iptables -P INPUT   DROP
    iptables -P FORWARD DROP
    iptables -P OUTPUT  DROP

    # Loopback
    iptables -A INPUT  -i lo -j ACCEPT
    iptables -A OUTPUT -o lo -j ACCEPT

    # Established/related connections
    iptables -A INPUT  -m state --state ESTABLISHED,RELATED -j ACCEPT
    iptables -A OUTPUT -m state --state ESTABLISHED,RELATED -j ACCEPT

    # Tor process — allowed to reach the internet directly (connects to relays)
    iptables -A OUTPUT -m owner --uid-owner "$TOR_USER" -j ACCEPT

    # DHCP — needed to get/renew IP address from router
    iptables -A OUTPUT -p udp --dport 67 -j ACCEPT
    iptables -A INPUT  -p udp --sport 67 --dport 68 -j ACCEPT

    # FIX 3: Allow non-Tor users to reach Tor's local listeners on loopback.
    # The nat table redirects their TCP to TransPort (9040) and DNS to DNSPort (5300),
    # but the filter OUTPUT chain also sees these packets and must explicitly allow them.
    # Without these rules, all browser/app traffic is silently dropped even though
    # the nat redirect is in place.
    iptables -A OUTPUT -d 127.0.0.1 -p tcp --dport "$TOR_TRANS_PORT" -j ACCEPT
    iptables -A OUTPUT -d 127.0.0.1 -p tcp --dport "$TOR_SOCKS_PORT" -j ACCEPT
    iptables -A OUTPUT -d 127.0.0.1 -p udp --dport "$TOR_DNS_PORT"   -j ACCEPT
    iptables -A OUTPUT -d 127.0.0.1 -p tcp --dport "$TOR_DNS_PORT"   -j ACCEPT

    # Block all remaining UDP — DNS was redirected in nat table above,
    # anything else hitting filter here is not going through Tor
    iptables -A OUTPUT -p udp -j REJECT --reject-with icmp-port-unreachable

    # Block everything else outbound
    iptables -A OUTPUT -j REJECT --reject-with icmp-port-unreachable
}

# ============================================================================
# Configure Tor Browser profile to match tormode state
# When tormode is ON:  disable Tor Browser's own Tor (transparent proxy handles it)
# When tormode is OFF: re-enable Tor Browser's own Tor client
# ============================================================================
configure_torbrowser() {
    local mode="$1"   # "direct" or "tor"
    local TB_PROFILE_BASE="/var/lib/tonix-browser/.tor-browser"
    local PROFILE_DIR

    # Find the actual profile dir (named randomly under TorBrowser/Data/Browser/)
    PROFILE_DIR=$(find "$TB_PROFILE_BASE"         -maxdepth 5 -name "prefs.js" 2>/dev/null         | head -1 | xargs dirname 2>/dev/null || true)

    # If no existing profile, write to user.js in the default profile location
    # Tor Browser will apply user.js on next launch even before prefs.js exists
    if [[ -z "$PROFILE_DIR" ]]; then
        PROFILE_DIR="$TB_PROFILE_BASE/tbb/TorBrowser/Data/Browser/profile.default"
        mkdir -p "$PROFILE_DIR"
        chown -R tonix-browser:tonix-browser "$TB_PROFILE_BASE" 2>/dev/null || true
    fi

    local USER_JS="$PROFILE_DIR/user.js"

    if [[ "$mode" == "direct" ]]; then
        # tormode ON — transparent proxy handles routing, Tor Browser goes direct
        cat > "$USER_JS" << 'TBUSERJS'
// Tonix: tormode is ON — transparent proxy routes all traffic through Tor.
// Tor Browser's own Tor client is disabled to avoid Tor-over-Tor.
user_pref("network.proxy.type", 0);
user_pref("extensions.torbutton.use_nontor_proxy", true);
user_pref("extensions.torlauncher.start_tor", false);
user_pref("extensions.torlauncher.prompt_at_startup", false);
user_pref("browser.startup.homepage_override.mstone", "ignore");
TBUSERJS
        chown tonix-browser:tonix-browser "$USER_JS" 2>/dev/null || true
        echo -e "${CYAN}Tor Browser configured: direct connection (transparent proxy active)${NC}"
    else
        # tormode OFF — Tor Browser should use its own built-in Tor
        cat > "$USER_JS" << 'TBUSERJS'
// Tonix: tormode is OFF — Tor Browser uses its own built-in Tor client.
user_pref("network.proxy.type", 1);
user_pref("extensions.torbutton.use_nontor_proxy", false);
user_pref("extensions.torlauncher.start_tor", true);
user_pref("extensions.torlauncher.prompt_at_startup", true);
TBUSERJS
        chown tonix-browser:tonix-browser "$USER_JS" 2>/dev/null || true
        echo -e "${CYAN}Tor Browser configured: using built-in Tor client${NC}"
    fi
}

# ============================================================================
# tor_on
# ============================================================================
tor_on() {
    echo -e "${YELLOW}Activating Tor-only mode...${NC}"

    configure_tor

    # FIX 2: Disable AppArmor before starting Tor so it can bind to custom ports
    disable_apparmor_for_tor

    # Start/restart Tor to pick up the new config
    if systemctl is-active --quiet tor; then
        systemctl restart tor
    else
        systemctl start tor
    fi

    # Wait for Tor to fully bootstrap BEFORE locking down the network.
    # If we apply iptables while Tor is still bootstrapping, Tor gets cut off
    # from its directory servers and can never finish — causing total lockout.
    if ! wait_for_tor; then
        echo -e "${RED}Aborting tormode — Tor did not bootstrap successfully.${NC}"
        echo -e "${YELLOW}Tor is running but network is NOT locked down.${NC}"
        echo -e "${YELLOW}Try: journalctl -u tor -n 50   to diagnose${NC}"
        # Restore AppArmor since we disabled it
        restore_apparmor_for_tor
        return 1
    fi

    apply_iptables

    # Configure Tor Browser to use direct connection (transparent proxy handles Tor routing)
    configure_torbrowser "direct"

    echo "on" > "$STATE_FILE"

    echo ""
    echo -e "${GREEN}✔ Tor-only mode ACTIVE${NC}"
    echo "  All TCP is transparently routed through Tor."
    echo "  DNS is resolved by Tor (no leaks)."
    echo "  All UDP except DHCP is blocked."
    echo "  IPv6 is fully blocked."
    echo ""
    echo -n "  Your Tor exit IP: "
    curl -s --max-time 15 --socks5-hostname 127.0.0.1:${TOR_SOCKS_PORT} \
        https://check.torproject.org/api/ip 2>/dev/null \
        | grep -o '"IP":"[^"]*"' | cut -d'"' -f4 \
        || echo "(checking — Tor may still be warming up, try: tonix-tormode status)"
    echo ""
}

# ============================================================================
# tor_off
# ============================================================================
tor_off() {
    echo -e "${YELLOW}Deactivating Tor-only mode...${NC}"

    # Remove the transparent proxy drop-in
    rm -f "$TOR_DROPIN"

    # Restore AppArmor for Tor
    restore_apparmor_for_tor

    # Restart Tor without transparent proxy config
    systemctl restart tor 2>/dev/null || true

    # Flush iptables and reset to open defaults
    iptables  -F
    iptables  -t nat -F
    iptables  -t mangle -F
    iptables  -P INPUT   ACCEPT
    iptables  -P FORWARD ACCEPT
    iptables  -P OUTPUT  ACCEPT

    ip6tables -F
    ip6tables -t nat -F 2>/dev/null || true
    ip6tables -P INPUT   ACCEPT
    ip6tables -P FORWARD ACCEPT
    ip6tables -P OUTPUT  ACCEPT

    # Re-enable UFW
    systemctl start ufw 2>/dev/null || true
    ufw --force enable  2>/dev/null || true

    # Restore Tor Browser to use its own built-in Tor client
    configure_torbrowser "tor"

    echo "off" > "$STATE_FILE"

    echo -e "${GREEN}✔ Normal networking restored${NC}"
    echo "  Direct connections allowed."
    echo "  UFW firewall re-enabled."
}

# ============================================================================
# tor_status
# ============================================================================
tor_status() {
    local state="off"
    [[ -f "$STATE_FILE" ]] && state=$(cat "$STATE_FILE")

    if [[ "$state" == "on" ]]; then
        echo -e "Tor-only mode: ${GREEN}ACTIVE${NC}"
        echo ""
        echo "  Transparent proxy:  127.0.0.1:${TOR_TRANS_PORT}"
        echo "  DNS port:           127.0.0.1:${TOR_DNS_PORT}"
        echo "  SOCKS proxy:        127.0.0.1:${TOR_SOCKS_PORT}"
        echo ""

        if systemctl is-active --quiet tor; then
            echo -e "  Tor service:  ${GREEN}running${NC}"
        else
            echo -e "  Tor service:  ${RED}stopped (!)${NC}"
        fi

        echo ""
        echo -n "  Tor exit IP: "
        curl -s --max-time 10 --socks5-hostname 127.0.0.1:${TOR_SOCKS_PORT} \
            https://check.torproject.org/api/ip 2>/dev/null \
            | grep -o '"IP":"[^"]*"' | cut -d'"' -f4 \
            || echo "(unreachable)"

        echo ""
        echo "  Active redirect rules:"
        iptables -t nat -L OUTPUT --line-numbers -n 2>/dev/null \
            | grep -E "REDIRECT|redir" || echo "  (none found)"
    else
        echo -e "Tor-only mode: ${YELLOW}OFF${NC} (normal networking)"
        echo ""
        if systemctl is-active --quiet tor; then
            echo -e "  Tor service: ${GREEN}running${NC} (SOCKS available at 127.0.0.1:${TOR_SOCKS_PORT})"
        else
            echo -e "  Tor service: ${RED}stopped${NC}"
        fi
    fi
}

# ============================================================================
# Entry point
# ============================================================================
case "${1:-}" in
    on|enable)
        tor_on
        ;;
    off|disable)
        tor_off
        ;;
    status)
        tor_status
        ;;
    *)
        echo "Tonix Tor Mode"
        echo ""
        echo "Usage: tonix-tormode {on|off|status}"
        echo ""
        echo "  on      Force ALL traffic through Tor (transparent, no app config needed)"
        echo "  off     Restore normal networking"
        echo "  status  Show current mode and exit IP"
        ;;
esac
